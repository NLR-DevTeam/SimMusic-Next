{
  "id": "local",
  "name": "本地音乐",
  "version": "1.5.3",
  "author": "SimMusic",
  "description": "基础本地音源扩展，提供内置的本地音频文件播放支持，亦可编辑歌曲元数据。",
  "main": "main.js",
  "permissions": ["fs.read", "fs.write", "shell", "sidebar", "trackMenu", "webview"],
