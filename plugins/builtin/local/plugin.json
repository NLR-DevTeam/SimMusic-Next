  "schemes": [{ "scheme": "local", "download": false }],
  "trackMenus": [{ "key": "reveal", "label": "在资源管理器中打开", "icon": "ED70", "scenes": ["list", "play", "queue"], "selection": "single", "permissions": ["shell"] }, { "key": "editTags", "label": "编辑元数据", "icon": "EC86", "scenes": ["list", "play", "queue"], "selection": "single", "permissions": ["fs.write", "webview"] }]
}
